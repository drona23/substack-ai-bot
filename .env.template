# ─────────────────────────────────────────────────────────
#  SubstackBot – Environment Variables
#  Copy this file to ".env" and fill in your values.
# ─────────────────────────────────────────────────────────

# 1. Your Anthropic API key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# 2. Your Substack session cookie (see setup guide for how to get this)
#    It looks like: connect.sid=s%3A...
SUBSTACK_COOKIE=connect.sid=s%3A...

# 3. (Optional) Pexels API key for free cover images
#    Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=
